rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Inquiries collection
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.email == "Chandvanibharat@gmail.com");
      allow update, delete: if request.auth != null && request.auth.token.email == "Chandvanibharat@gmail.com";
    }

    // Project Reviews collection
    match /projectReviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.email == "Chandvanibharat@gmail.com");
    }
  }
}
